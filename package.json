    "babel-loader": "^10.1.1",
    "css-loader": "^6.11.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "html-webpack-plugin": "^5.6.8",
    "node-loader": "^2.1.0",
    "oxfmt": "^0.41.0",
