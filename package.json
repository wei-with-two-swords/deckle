    "url": "https://github.com/wei-with-two-swords/deckle/issues"
  },
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "dist": "npm run build && node scripts/dist.mjs",
    "package": "npm run build && node scripts/dist.mjs --dir",
    "make": "npm run dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "licenses": "node scripts/collect-licenses.mjs",
