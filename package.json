{
  "name": "deckle",
  "productName": "Deckle",
  "version": "1.0.0",
  "private": true,
  "description": "Deckle — a desktop Typst paper editor",
  "keywords": [
    "typst",
    "editor",
    "desktop",
    "academic-writing",
    "electron"
  ],
  "license": "Apache-2.0",
